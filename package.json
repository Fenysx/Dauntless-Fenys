{
  "name": "dauntless-launcher-ultimate",
  "version": "1.7.0-beta.2",
  "private": true,
  "description": "Launcher comunitário do Dauntless",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "test": "node --test test/*.test.js",
    "server:prepare": "node scripts/prepare-server.cjs",
    "cloud:authorization": "node scripts/create-cloud-authorization.cjs",
    "test:integration": "node scripts/test-integration.cjs",
    "doctor": "node scripts/doctor.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Dauntless Launcher Ultimate",
  "build": {
    "appId": "br.com.fenys.dauntless",
    "productName": "Dauntless Launcher Ultimate",
    "directories": {
      "output": "release"
    },
    "linux": {
      "category": "Game",
      "maintainer": "Comunidade"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE*",
      "NOTICE*"
    ]
  },
  "author": {
    "name": "Comunidade"
  }
}
